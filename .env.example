# Copy to .env and fill in from Supabase → Project Settings → API.
# The publishable key is safe in the app; row-level security is what protects the data.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# "on" once Supabase has an SMS provider (Twilio, MSG91...); otherwise sign-in uses email codes.
EXPO_PUBLIC_PHONE_AUTH=off
# Optional dev-only sign-in (hidden in release builds): a confirmed email+password user in your dev project.
EXPO_PUBLIC_DEV_EMAIL=
EXPO_PUBLIC_DEV_PASSWORD=

# demo APK only: shows "Try the demo" on the sign-in screen (set in the EAS preview environment, never production)
EXPO_PUBLIC_DEMO_LOGIN=
