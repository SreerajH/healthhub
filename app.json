{
  "expo": {
    "name": "HealthHub",
    "slug": "healthhub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "healthhub",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F1F3F8",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.sreerajh.healthhub"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F2E5C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sreerajh.healthhub"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F2E5C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "HealthHub uses your photos so you can add a picture to a family member's profile and upload health records.",
          "cameraPermission": "HealthHub uses the camera so you can photograph prescriptions and reports.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#1F2E5C",
          "defaultChannel": "reminders",
          "enableRemoteNotifications": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "sreerajh",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "82c0591a-b61d-4c8e-9d47-a8715ab07cb4"
      }
    }
  }
}
